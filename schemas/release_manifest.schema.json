{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionexp.com/schemas/hk-movie-rag/release_manifest.schema.json",
  "title": "Production-authorizing Release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_version",
    "source_manifest_sha256",
    "source_generated_at",
    "expected_counts",
    "poster_state_counts",
    "artifacts"
  ],
  "properties": {
    "release_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_generated_at": {"type": "string", "format": "date-time"},
    "expected_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_movies",
        "quarantine_movies",
        "tier_counts",
        "pilot_movies",
        "audit_rows"
      ],
      "properties": {
        "release_movies": {"type": "integer", "minimum": 0},
        "quarantine_movies": {"type": "integer", "minimum": 0},
        "tier_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "pilot_movies": {"type": "integer", "minimum": 0},
        "audit_rows": {"type": "integer", "minimum": 0}
      }
    },
    "poster_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_passed", "content_conflict", "placeholder", "missing"],
      "properties": {
        "machine_passed": {"type": "integer", "minimum": 0},
        "content_conflict": {"type": "integer", "minimum": 0},
        "placeholder": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[A-Za-z0-9._-]+)?(?:/|$))(?!.*\\/(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[A-Za-z0-9._-]+)?(?:/|$))[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "schema_path", "size_bytes", "sha256", "row_count"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "schema_path": {"$ref": "#/$defs/relativePath"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
