{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionexp.com/schemas/hk-movie-rag/rag_release_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rag_release_id", "parent_release_manifest_sha256", "bundle", "counts", "facet_artifacts", "poster_derivation", "models", "access_mode", "documents"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "rag_release_id": {"type": "string", "minLength": 1},
    "parent_release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "size_bytes"], "properties": {"filename": {"const": "rag_bundle.jsonl"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["movies", "facet_count", "tier_s_count", "tier_a_count", "tier_b_count", "pilot_count", "poster_rows", "primary_poster_rows", "approved_poster_objects", "unavailable_poster_rows", "derived_poster_bytes", "metadata_passages", "documents", "pdf_passages"], "properties": {"movies": {"type": "integer", "minimum": 0}, "facet_count": {"type": "integer", "minimum": 0}, "tier_s_count": {"type": "integer", "minimum": 0}, "tier_a_count": {"type": "integer", "minimum": 0}, "tier_b_count": {"type": "integer", "minimum": 0}, "pilot_count": {"type": "integer", "minimum": 0}, "poster_rows": {"type": "integer", "minimum": 0}, "primary_poster_rows": {"type": "integer", "minimum": 0}, "approved_poster_objects": {"type": "integer", "minimum": 0}, "unavailable_poster_rows": {"type": "integer", "minimum": 0}, "derived_poster_bytes": {"type": "integer", "minimum": 0}, "metadata_passages": {"type": "integer", "minimum": 0}, "documents": {"type": "integer", "const": 2}, "pdf_passages": {"type": "integer", "minimum": 0}}},
    "facet_artifacts": {"type": "object", "additionalProperties": false, "required": ["movie_tiers", "pilot_movies"], "properties": {"movie_tiers": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "row_count"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "row_count": {"type": "integer", "minimum": 0}}}, "pilot_movies": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "row_count"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "row_count": {"type": "integer", "minimum": 0}}}}},
    "poster_derivation": {"type": "object", "additionalProperties": false, "required": ["derived_is_primary", "mode", "source_is_primary_field", "derived_object_key_template", "derived_mime_type", "unavailable_identity", "expected_approved_poster_objects", "expected_unavailable_poster_rows", "derived_inventory_sha256"], "properties": {"derived_is_primary": {"const": true}, "mode": {"const": "one_state_row_per_movie"}, "source_is_primary_field": {"const": "source_is_primary"}, "derived_object_key_template": {"const": "assets/posters/derived/{movie_id}.webp"}, "derived_mime_type": {"const": "image/webp"}, "unavailable_identity": {"const": "absent"}, "expected_approved_poster_objects": {"type": "integer", "minimum": 0}, "expected_unavailable_poster_rows": {"type": "integer", "minimum": 0}, "derived_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "models": {"type": "object", "additionalProperties": false, "required": ["embedding_model", "embedding_dimension", "generation_model"], "properties": {"embedding_model": {"type": "string", "minLength": 1}, "embedding_dimension": {"type": "integer", "const": 768}, "generation_model": {"type": "string", "minLength": 1}}},
    "access_mode": {"const": "restricted_demo"},
    "documents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["movie_id", "document_id", "source_filename", "source_sha256", "rights_status", "quality_status"], "properties": {"movie_id": {"type": "string", "minLength": 1}, "document_id": {"type": "string", "minLength": 1}, "source_filename": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rights_status": {"type": "string", "minLength": 1}, "quality_status": {"type": "string", "minLength": 1}}}}
  }
}
