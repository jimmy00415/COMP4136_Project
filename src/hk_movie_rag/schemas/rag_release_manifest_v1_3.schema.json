{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionexp.com/schemas/hk-movie-rag/rag_release_manifest_v1_3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rag_release_id", "parent_rag_release_id", "parent_release_manifest_sha256", "bundle", "counts", "facet_artifacts", "poster_derivation", "models", "text_extraction_profile", "document_embedding_profile", "relevance_policy_sha256", "poster_authority_sha256", "access_mode", "documents", "supplemental_movies", "supplemental_facets", "supplemental_posters"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "rag_release_id": {"type": "string", "minLength": 1},
    "parent_rag_release_id": {"type": "string", "minLength": 1},
    "parent_release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "size_bytes"], "properties": {"filename": {"const": "rag_bundle.jsonl"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["movies", "facet_count", "tier_s_count", "tier_a_count", "tier_b_count", "pilot_count", "poster_rows", "primary_poster_rows", "approved_poster_objects", "unavailable_poster_rows", "derived_poster_bytes", "metadata_passages", "documents", "pdf_passages"], "properties": {"movies": {"type": "integer", "minimum": 0}, "facet_count": {"type": "integer", "minimum": 0}, "tier_s_count": {"type": "integer", "minimum": 0}, "tier_a_count": {"type": "integer", "minimum": 0}, "tier_b_count": {"type": "integer", "minimum": 0}, "pilot_count": {"type": "integer", "minimum": 0}, "poster_rows": {"type": "integer", "minimum": 0}, "primary_poster_rows": {"type": "integer", "minimum": 0}, "approved_poster_objects": {"type": "integer", "minimum": 0}, "unavailable_poster_rows": {"type": "integer", "minimum": 0}, "derived_poster_bytes": {"type": "integer", "minimum": 0}, "metadata_passages": {"type": "integer", "minimum": 0}, "documents": {"type": "integer", "minimum": 1}, "pdf_passages": {"type": "integer", "minimum": 1}}},
    "facet_artifacts": {"type": "object", "additionalProperties": false, "required": ["movie_tiers", "pilot_movies"], "properties": {"movie_tiers": {"$ref": "#/$defs/artifact"}, "pilot_movies": {"$ref": "#/$defs/artifact"}}},
    "poster_derivation": {"type": "object", "additionalProperties": false, "required": ["derived_is_primary", "mode", "source_is_primary_field", "derived_object_key_template", "derived_mime_type", "unavailable_identity", "expected_approved_poster_objects", "expected_unavailable_poster_rows", "derived_inventory_sha256"], "properties": {"derived_is_primary": {"const": true}, "mode": {"const": "one_state_row_per_movie"}, "source_is_primary_field": {"const": "source_is_primary"}, "derived_object_key_template": {"const": "assets/posters/derived/{movie_id}.webp"}, "derived_mime_type": {"const": "image/webp"}, "unavailable_identity": {"const": "absent"}, "expected_approved_poster_objects": {"type": "integer", "minimum": 0}, "expected_unavailable_poster_rows": {"type": "integer", "minimum": 0}, "derived_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "models": {"type": "object", "additionalProperties": false, "required": ["embedding_model", "embedding_dimension", "generation_model"], "properties": {"embedding_model": {"type": "string", "minLength": 1}, "embedding_dimension": {"type": "integer", "const": 768}, "generation_model": {"type": "string", "minLength": 1}}},
    "text_extraction_profile": {"const": "cjk-layout-v1"},
    "document_embedding_profile": {"const": "vertex-title-text-v1"},
    "relevance_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "poster_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_mode": {"const": "restricted_demo"},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "supplemental_movies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/movie"}},
    "supplemental_facets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/facet"}},
    "supplemental_posters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/poster"}}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "row_count"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "row_count": {"type": "integer", "minimum": 0}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["movie_id", "document_id", "source_filename", "source_sha256", "rights_status", "quality_status", "page_count"], "properties": {"movie_id": {"type": "string", "minLength": 1}, "document_id": {"type": "string", "minLength": 1}, "source_filename": {"type": "string", "pattern": "^(?!\\.\\.?$)[^/\\\\]+$"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rights_status": {"const": "restricted"}, "quality_status": {"const": "manual_approved"}, "page_count": {"type": "integer", "minimum": 1}}},
    "movie": {"type": "object", "additionalProperties": false, "required": ["movie_id", "chinese_title", "english_title", "release_date", "production_region", "director", "screenwriter", "cast", "genre", "runtime_minutes", "production_company", "data_source"], "properties": {"movie_id": {"type": "string", "minLength": 1}, "chinese_title": {"type": "string", "minLength": 1}, "english_title": {"type": "string", "minLength": 1}, "release_date": {"type": "string", "format": "date"}, "production_region": {"type": "string", "minLength": 1}, "director": {"type": "string", "minLength": 1}, "screenwriter": {"type": "string", "minLength": 1}, "cast": {"type": "string", "minLength": 1}, "genre": {"type": "string", "minLength": 1}, "runtime_minutes": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "production_company": {"type": "string", "minLength": 1}, "data_source": {"type": "string", "minLength": 1}}},
    "facet": {"type": "object", "additionalProperties": false, "required": ["movie_id", "tier", "tier_reason", "human_review", "pilot_movie", "pilot_evidence"], "properties": {"movie_id": {"type": "string", "minLength": 1}, "tier": {"enum": ["S", "A", "B"]}, "tier_reason": {"type": "string", "minLength": 1}, "human_review": {"type": "string", "minLength": 1}, "pilot_movie": {"type": "boolean"}, "pilot_evidence": {"type": ["object", "null"]}}},
    "poster": {"type": "object", "additionalProperties": false, "required": ["asset_id", "movie_id", "asset_type", "source_object_uri", "original_object_uri", "derived_object_uri", "quarantine_object_uri", "content_sha256", "detected_format", "detected_mime_type", "detected_extension", "width", "height", "color_mode", "byte_length", "quality_status", "identity_confidence", "source_url", "rights_status", "version", "is_primary", "publishable", "created_at", "reviewed_at"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "movie_id": {"type": "string", "minLength": 1}, "asset_type": {"const": "poster"}, "source_object_uri": {"type": "string"}, "original_object_uri": {"type": "string"}, "derived_object_uri": {"type": "string"}, "quarantine_object_uri": {"type": "string"}, "content_sha256": {"type": "string"}, "detected_format": {"type": "string"}, "detected_mime_type": {"type": "string"}, "detected_extension": {"type": "string"}, "width": {"type": ["integer", "null"]}, "height": {"type": ["integer", "null"]}, "color_mode": {"type": "string"}, "byte_length": {"type": ["integer", "null"]}, "quality_status": {"type": "string", "minLength": 1}, "identity_confidence": {"type": ["number", "null"]}, "source_url": {"type": ["string", "null"]}, "rights_status": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "is_primary": {"type": "boolean"}, "publishable": {"type": "boolean"}, "created_at": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"]}}}
  }
}
